#pragma once
#define offset_OnCalcDamage(uintptr_t)Il2CppGetMethodOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("FDAEPHMIEPC"),  OBFUSCATE("KOODEKEKFEK"), 1)
#define offset_GetHeadCollider_Silent(uintptr_t)Il2CppGetMethodOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("Player"), OBFUSCATE("get_HeadCollider"), 0)
#define offset_GetGameObject(uintptr_t)Il2CppGetMethodOffset(OBFUSCATE("UnityEngine.CoreModule.dll"), OBFUSCATE("UnityEngine"), OBFUSCATE("Component"), OBFUSCATE("get_gameObject"), 0)
#define offset_HitObject(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("HLIJMDODPIM"))
#define offset_HitCollider(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("OCEBCHENIOK"))
#define offset_HitGroup(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("FLCLOHCBJEI"))
#define offset_HitLocation(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("MBGBCLNJOMK"))
#define offset_HitNormal(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("DGFLGBEOGPG"))
#define offset_RayDir(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("IKDEGKIICJP"))
#define offset_IgnoreHappens(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("DEDOKPCAHAC"))
#define offset_ViewBlocked(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("GGJOADOBLID"))
#define offset_SpecialHitType(uintptr_t)Il2CppGetFieldOffset(OBFUSCATE("Assembly-CSharp.dll"), OBFUSCATE("COW.GamePlay"), OBFUSCATE("GMPGMPFNMFP"), OBFUSCATE("LNOIFBAFGOK"))

bool AimSilent = false;
static bool g_AimSilentHookInstalled = false;

static void *GetHeadColliderSilent(void *player) {
  if (!player) return nullptr;
  void *(*_GetHead)(void *) = (void *(*)(void *))(offset_GetHeadCollider_Silent);
  return _GetHead(player);
}

static void *get_gameObject_Silent(void *component) {
  if (!component) return nullptr;
  void *(*_GetObj)(void *) = (void *(*)(void *))(offset_GetGameObject);
  return _GetObj(component);
}


static bool IsEnemyVisibleSilent(void *enemy) {
if (!enemy) return false;

void *hitObj = NULL;
Vector3 cameraPos = Transform_GetPosition(Component_GetTransform(Camera_main()));
Vector3 targetPos = Transform_GetPosition(Component_GetTransform(Player_GetHeadCollider(enemy)));

return !Physics_Raycast(cameraPos, targetPos, 12, &hitObj);
}

static void *GetClosestEnemySilent() {
float minAngle = 9999.0f;
void *targetEnemy = nullptr;

void *match = Curent_Match();  
if (!match) return nullptr;  

void *localPlayer = GetLocalPlayer(match);  
if (!localPlayer) return nullptr;  

void *camera = Camera_main();  
if (!camera) return nullptr;  

Vector3 myPos = getPosition(localPlayer);  
Vector3 camFwd = GetForward(Component_GetTransform(camera));  

MyDictionary* dict = *(MyDictionary**)((uintptr_t)match + ListPlayer);  
if (!dict || !dict->entries) return nullptr;  

int total = dict->entries->max_length;  
if (total <= 0 || total > 512) return nullptr;  

for (int i = 0; i < total; i++) {  
    auto entry = dict->entries->vector[i];  

    if (!entry.value) continue;  

    void *enemy = entry.value;  

    if (!enemy || enemy == localPlayer) continue;  
    if (get_isLocalTeam(enemy)) continue;  
    if (get_IsDieing(enemy)) continue;  
    if (get_MaxHP(enemy) <= 0) continue;  

    Vector3 enemyPos = getPosition(enemy);  
    float dist = Vector3::Distance(myPos, enemyPos);  
    if (dist > 1000.0f) continue;  

    Vector3 screenPos = WorldToScreenPoint(camera, enemyPos);  
    if (screenPos.z < 1) continue;  

    if (!IsEnemyVisibleSilent(enemy)) continue;  

    Vector3 dir = Vector3::Normalized(enemyPos - myPos);  
    float angle = Vector3::Angle(dir, camFwd) * 100.0f;  

    if (angle < minAngle) {  
        minAngle = angle;  
        targetEnemy = enemy;  
    }  
}  

return targetEnemy;

}

void (*orig_OnCalcDamage)(void *weapon, void *hitInfo);

void hook_OnCalcDamage(void *weapon, void *hitInfo) {
if (!AimSilent) {
orig_OnCalcDamage(weapon, hitInfo);
return;
}

if (!weapon || !hitInfo) {  
    if (orig_OnCalcDamage) orig_OnCalcDamage(weapon, hitInfo);  
    return;  
}  
  
void *match = Curent_Match();  
if (!match) {  
    orig_OnCalcDamage(weapon, hitInfo);  
    return;  
}  
  
void *localPlayer = GetLocalPlayer(match);  
if (!localPlayer) {  
    orig_OnCalcDamage(weapon, hitInfo);  
    return;  
}  
  
void *target = GetClosestEnemySilent();  
if (!target) {  
    orig_OnCalcDamage(weapon, hitInfo);  
    return;  
}  
  
if (get_IsDieing(target) || get_isLocalTeam(target)) {  
    orig_OnCalcDamage(weapon, hitInfo);  
    return;  
}  
  
void *headCollider = GetHeadColliderSilent(target);  
if (!headCollider) {  
    orig_OnCalcDamage(weapon, hitInfo);  
    return;  
}  
  
void *headGameObject = get_gameObject_Silent(headCollider);  
if (!headGameObject) {  
    orig_OnCalcDamage(weapon, hitInfo);  
    return;  
}  
  
Vector3 enemyHeadPos = GetHeadPosition(target);  
Vector3 myPos = getPosition(localPlayer);  
  
float dx = enemyHeadPos.x - myPos.x;  
float dy = enemyHeadPos.y - myPos.y;  
float dz = enemyHeadPos.z - myPos.z;  
float len = dx*dx + dy*dy + dz*dz;  
  
Vector3 direction = {0, 0, 1};  
if (len > 0.01f) {  
    len = sqrt(len);  
    direction.x = dx / len;  
    direction.y = dy / len;  
    direction.z = dz / len;  
}  
  
*(void **)((uintptr_t)hitInfo + offset_HitObject) = headGameObject;
*(void **)((uintptr_t)hitInfo + offset_HitCollider) = headCollider;
*(int *)((uintptr_t)hitInfo + offset_HitGroup) = 1;  // Head = 1
*(Vector3 *)((uintptr_t)hitInfo + offset_HitLocation) = enemyHeadPos;
*(Vector3 *)((uintptr_t)hitInfo + offset_HitNormal) = direction;
*(Vector3 *)((uintptr_t)hitInfo + offset_RayDir) = direction;
*(bool *)((uintptr_t)hitInfo + offset_IgnoreHappens) = false;
*(bool *)((uintptr_t)hitInfo + offset_ViewBlocked) = false;
*(uint8_t *)((uintptr_t)hitInfo + offset_SpecialHitType) = 0;

orig_OnCalcDamage(weapon, hitInfo);

}

void InitAimSilentHook() {
if (g_AimSilentHookInstalled) return;

uintptr_t addr = offset_OnCalcDamage;  
if (!addr || addr < 0x100000) return;  
  
DobbyHook((void *)addr, (void *)hook_OnCalcDamage, (void **)&orig_OnCalcDamage);  
g_AimSilentHookInstalled = true;

}
